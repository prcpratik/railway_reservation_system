# ============================================================
# Dockerfile for Python GenAI (RAG Chatbot) Service
# ============================================================
# This service uses:
#   - FastAPI (web framework)
#   - LangChain + Groq (LLM inference)
#   - ChromaDB (vector database for RAG)
#   - HuggingFace sentence-transformers (text embeddings)
#
# We use a slim Python image to keep the size manageable.
# The chroma-db folder (pre-built vector index) is copied in.
# ============================================================


# Use Python 3.11 slim image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system-level dependencies that some Python packages need
# (like gcc for compiling C extensions)
RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc g++ && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (Docker layer caching)
COPY requirements.txt .

# Install all Python packages
# --no-cache-dir → don't store pip cache (keeps image smaller)
RUN pip install --no-cache-dir -r requirements.txt

# Copy the application code
COPY main.py .
COPY build_knowledge.py .

# Copy the pre-built vector database
# (this was generated by running build_knowledge.py locally)
COPY chroma-db ./chroma-db

# Copy source PDFs (needed if you want to rebuild the knowledge base)
COPY sourcepdf ./sourcepdf

# The GenAI service runs on port 8083
EXPOSE 8083

# Start the FastAPI server using Uvicorn
# --host 0.0.0.0 → accept connections from outside the container
# (without this, only processes INSIDE the container could connect)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8083"]
